# Configuration du serveur HTTP
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Sécurité et limites de débit (Rate Limiting)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_URL_LENGTH=2048

# Configuration des fournisseurs de Threat Intelligence
# Délai maximum d'attente par fournisseur (en millisecondes)
PROVIDER_TIMEOUT_MS=3000

# Google Safe Browsing Lookup API v4 (Usage non-commercial uniquement)
# Obtenir une clé : https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus Community API (abuse.ch - Usage non-commercial / Fair Use)
# Obtenir une clé gratuite : https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
